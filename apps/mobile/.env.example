# Public keys only. The service role key must NEVER appear in this app —
# it bypasses Row Level Security (§9).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Onde ficam os endpoints de cobrança (o deploy do painel).
# É para lá que o aplicativo pede a sessão de checkout do Stripe.
EXPO_PUBLIC_BILLING_URL=http://localhost:3000

# Mapa do replay de trajeto (ArcGIS Location Platform, plano gratuito).
# Restrinja a chave a "basemaps" no console da Esri antes de publicar — ela vai
# embutida no aplicativo, como toda variável EXPO_PUBLIC_.
# Sem ela o app não quebra: o replay cai no traço desenhado da marca.
EXPO_PUBLIC_ARCGIS_API_KEY=
