{
  "$schema": "https://json.schemastore.org/eas.json",
  "cli": { "version": ">= 12.0.0", "appVersionSource": "remote" },
  "build": {
    "base": {
      "node": "22.11.0",
      "env": { "EXPO_PUBLIC_BILLING_URL": "https://dinamique.app" }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "android": { "buildType": "apk" }
    },
    "production": { "extends": "base", "channel": "production", "autoIncrement": true }
  },
  "submit": { "production": {} }
}
