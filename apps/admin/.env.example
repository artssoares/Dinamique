# Browser-visible (safe): used by the client for auth.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_,
# never import into a Client Component, never commit a real value (§9, §128).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------------ Stripe --
# SERVIDOR APENAS. A chave secreta cobra dinheiro de verdade: nunca com
# prefixo NEXT_PUBLIC_, nunca no aplicativo, nunca versionada.
STRIPE_SECRET_KEY=sk_test_...

# Segredo do webhook (whsec_...). É com ele que verificamos que a requisição
# veio mesmo do Stripe. Sem essa verificação, qualquer um concede Pro a si
# mesmo mandando um POST.
STRIPE_WEBHOOK_SECRET=whsec_...

# Para onde o usuário volta depois do checkout.
NEXT_PUBLIC_APP_URL=http://localhost:3000
