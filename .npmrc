# O Metro resolve pelo sistema de arquivos, não pelo algoritmo do Node, e vários
# pacotes do ecossistema Expo dependem de bibliotecas que nunca declaram. Um
# node_modules achatado é o formato que a Expo documenta para monorepos pnpm.
#
# Todo o repositório usa React 19 (Expo SDK 53 / React Native 0.79 e Next 15),
# então não existe mais o conflito de duas versões de React que exigia exclusões
# aqui. Se algum dia os dois lados precisarem de majors diferentes, esta decisão
# precisa ser revista junto — não com um remendo no hoisting.
node-linker=hoisted

strict-peer-dependencies=false
auto-install-peers=true
