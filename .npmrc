# Metro resolves from the filesystem rather than Node's algorithm, and several
# packages in the Expo toolchain require transitive dependencies they never
# declare. Enumerating them is a losing game, so everything is hoisted into the
# root node_modules — except React.
#
# React must NOT be hoisted. The mobile app is on React 18 (React Native 0.76)
# and the admin on React 19. Hoisting either one makes Next's styled-jsx bind a
# second React copy and every prerender fails with "Cannot read properties of
# null (reading 'useContext')". Each app keeps its own copy, and both builds
# are verified in CI.
public-hoist-pattern[]=*
public-hoist-pattern[]=!react
public-hoist-pattern[]=!react-dom
public-hoist-pattern[]=!@types/react
public-hoist-pattern[]=!@types/react-dom

strict-peer-dependencies=false
auto-install-peers=true
